{
  "manifest_version": 3,
  "name": "Hiregram Tailor",
  "version": "0.2.0",
  "description": "Send a job description (or job link) to Sara on hiregram.ai to tailor your resume.",
  "minimum_chrome_version": "116",
  "permissions": [
    "contextMenus",
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "options_page": "src/pages/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Tailor resume with Hiregram",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "https://hiregram.ai/*",
        "https://www.hiregram.ai/*"
      ],
      "js": ["src/content/overlay.js", "src/content/hotkey.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://hiregram.ai/*",
        "https://www.hiregram.ai/*"
      ],
      "js": ["src/content/hiregram-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
